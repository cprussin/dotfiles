{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "automerge": false,
  "separateMajorMinor": false,
  "minimumReleaseAge": "7 days",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "One weekly PR with every update; a Claude routine fixes it up (lockfiles, flake hashes, breaking changes) and merges it.",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "replacement"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all"
    }
  ]
}
