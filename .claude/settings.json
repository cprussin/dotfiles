{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pr-review-reminder.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pr-review-reminder.sh\""
          }
        ]
      }
    ]
  }
}
